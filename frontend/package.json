{
  "name": "score-rebar-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "esbuild scripts/render-smoke.ts --bundle --platform=node --format=cjs --external:jsdom --outfile=scripts/.render-smoke.cjs --log-level=error && node scripts/.render-smoke.cjs",
    "e2e": "esbuild scripts/e2e.ts --bundle --platform=node --format=cjs --external:playwright --external:playwright-core --outfile=.e2e.cjs --log-level=error && node .e2e.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vexflow": "4.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
